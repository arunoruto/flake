diff --git a/cmake/BuildParameters.cmake b/cmake/BuildParameters.cmake
index ce8cff1..efc5ff6 100644
--- a/cmake/BuildParameters.cmake
+++ b/cmake/BuildParameters.cmake
@@ -42,6 +42,11 @@ if(NOT APPLE)
 	option(USE_OPENGL "Enable OpenGL GS renderer" ON)
 endif()
 option(USE_VULKAN "Enable Vulkan GS renderer" ON)
+if(APPLE)
+	# The Metal shaders are precompiled with Xcode's `metal` compiler. Turning
+	# this off builds without Xcode; Vulkan (MoltenVK) is then the hardware renderer.
+	option(USE_METAL "Enable Metal GS renderer" ON)
+endif()
 # What the GL renderer asks the host for. Android is GL ES whether this is set
 # or not; it exists for the other platforms that have only ES - webOS, and the
 # embedded frontends - where a desktop GL request is refused and the core then
@@ -367,6 +372,10 @@ if(USE_VULKAN)
 	list(APPEND PCSX2_DEFS ENABLE_VULKAN)
 endif()
 
+if(USE_METAL)
+	list(APPEND PCSX2_DEFS ENABLE_METAL)
+endif()
+
 if(X11_API)
 	list(APPEND PCSX2_DEFS X11_API)
 endif()
